GEMINI_API_KEY=your_gemini_api_key

EMAIL_SENDER=your_sender_email
EMAIL_PASSWORD=sender_google_app_password
EMAIL_RECIPIENT=your_recieveing_email

SLACK_WEBHOOK_URL=your_slack_webhook

# Shared secret for admin actions (saving the alert schedule, sending alerts).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# If unset, admin actions are disabled (the API answers 503).
ADMIN_TOKEN=generate_a_long_random_token

# Deployed dashboard URL: allowed by CORS and used for links in emails/Slack.
FRONTEND_URL=http://localhost:5173

# false = every email goes to EMAIL_RECIPIENT (demo); true = to each engineer's own address.
PRODUCTION_MODE=false

# Minimum seconds between alert dispatches.
ALERT_COOLDOWN_SECONDS=300

# Scheduled alerts: how late (minutes) a cron tick may arrive and still send the slot.
SCHEDULE_GRACE_MINUTES=120

# Gemini model for coaching guides and team memos (default: gemini-3.8-flash, latest stable Flash).
# Prices per model and date live in ai/providers.py (GEMINI_PRICES).
GEMINI_MODEL=gemini-3.8-flash
