FROM python:3.10-slim

WORKDIR /app

# Install dependencies first so code changes don't invalidate this layer
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code (.dockerignore keeps local databases, venvs and tests out)
COPY . .

# The SQLite database lives outside the code tree so a volume can persist it
# without hiding code (data/ holds seed.py, schema.sql, the worker...).
ENV DB_PATH=/app/db/usage.db
RUN useradd --create-home appuser && mkdir -p /app/db && chown appuser /app/db
USER appuser

EXPOSE 8000

# Seed at container START (not build) and only when the database is empty: generated
# data is dated relative to the day the container starts, and a persisted volume is
# never overwritten. The API applies schema upgrades itself on startup.
# Render provides $PORT; locally it defaults to 8000.
CMD ["sh", "-c", "python data/seed.py --if-empty && exec uvicorn api.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
